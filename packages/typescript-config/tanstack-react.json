{
    "$schema": "https://json.schemastore.org/tsconfig",
    "extends": "./base.json",
    "compilerOptions": {
        "lib": ["ESNext"],
        "target": "esnext",
        "module": "esnext",
        "declaration": false,
        "declarationMap": false,
        "moduleResolution": "bundler",
        "allowImportingTsExtensions": true,
        "verbatimModuleSyntax": true,
        "noEmit": true,
        "allowJs": true,
        "jsx": "react-jsx"
    }
}